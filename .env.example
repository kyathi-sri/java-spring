# Copy to .env (git-ignored) and replace every value. Never commit real secrets.
# PowerShell: .\scripts\new-local-env.ps1 generates a .env with random values.
POSTGRES_PASSWORD=change-me
ACCOUNT_DB_PASSWORD=change-me
TRANSACTION_DB_PASSWORD=change-me
TRANSFER_DB_PASSWORD=change-me
# At least 32 characters. Shared by all services for local JWT validation only.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
